 "facts": [
  {
   "n": 1,
   "year": "1937",
   "text": "He moved with his family from Swatow to Singapore at around age 4 and settled in Chinatown.",
   "sources": [
    {
     "label": "Tan Howe Liang, Singapore\u2019s first Olympic medallist, dies at",
     "url": "https://singaporeolympics.com/tan-howe-liang-singapores-first-olympic-medallist-dies-at-91/"
    }
   ]
  },
  {
   "n": 2,
   "year": "1952",
   "text": "He joined the Evergreen Weightlifting Party in 1952 and trained with a single set of barbells.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 3,
   "year": "1953",
   "text": "After 1 year of training he won the National Junior and Senior titles in the lightweight division at age 20.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 4,
   "year": "1954",
   "text": "He placed fourth at the Asian Games in Manila in 1954.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 5,
   "year": "1956",
   "text": "He finished ninth at the 1956 Melbourne Olympics after losing consciousness during the competition.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 6,
   "year": "1958",
   "text": "He lifted 157 kg in the clean-and-jerk and won lightweight gold with a 358 kg total at the 1958 Commonwealth and Empire Games in Cardiff.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 7,
   "year": "1958",
   "text": "He won lightweight gold with a 375 kg total at the 1958 Asian Games in Tokyo.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 8,
   "year": "1959",
   "text": "He won lightweight gold with a 369 kg total at the first SEAP Games in Bangkok in 1959.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 9,
   "year": "1960",
   "text": "On 8 September 1960 he finished second among 35 competitors in the lightweight division at Rome with a 380 kg total and a 155 kg clean-and-jerk.",
   "sources": [
    {
     "label": "Tan Howe Liang wins Singapore\u2019s first Olympic medal",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=192ba4aa-8d0e-41ad-a474-705aef9cc324"
    }
   ]
  },
  {
   "n": 10,
   "year": "1961",
   "text": "He competed in the middleweight category for the first time at the 1961 SEAP Games in Rangoon and won silver.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 11,
   "year": "1962",
   "text": "He won middleweight gold with a 390 kg total at the 1962 Commonwealth Games in Perth.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 12,
   "year": "1962",
   "text": "He received the Pingat Jasa Gemilang (Meritorious Service Medal) at the 1962 National Day Awards.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 13,
   "year": "1968",
   "text": "He was appointed national weightlifting coach in 1968.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 14,
   "year": "1982",
   "text": "He began work with the Singapore Sports Council as a gymnasium supervisor in 1982 at the National Stadium.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 15,
   "year": "1984",
   "text": "He received the International Weightlifting Federation Gold Award in 1984.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 16,
   "year": "2008",
   "text": "He remained Singapore's only Olympic medallist for 48 years until the women's table tennis team won silver in 2008.",
   "sources": [
    {
     "label": "Tan Howe Liang",
     "url": "https://www.nlb.gov.sg/main/article-detail?cmsuuid=378f846d-c6e9-44e1-a232-82da795800ff"
    }
   ]
  },
  {
   "n": 17,
   "year": "2024",
   "text": "He died on 3 December 2024 at age 91.",
   "sources": [
    {
     "label": "Tan Howe Liang, Singapore\u2019s first Olympic medallist, dies at",
     "url": "https://singaporeolympics.com/tan-howe-liang-singapores-first-olympic-medallist-dies-at-91/"
    }
   ]
  }
 ],
